rules_version = '2';

// Firestore rules for Parks & Camping cloud sync, written so they can share a Firebase
// project with Real Food Hackz (whose rule for users/{uid} is kept as is).
// Paste into: Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Real Food Hackz: a signed-in user may read and write only their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Parks & Camping: same rule for each account's parks/{uid} document.
    match /parks/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
